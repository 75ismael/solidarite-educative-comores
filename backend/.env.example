# Configuration d'Environnement de Production — Solidarité Éducative Comores

# Sécurité (Générer une clé aléatoire forte en production)
SECRET_KEY=django-prod-secret-key-change-me-random-64-chars

# Mode Débogage (Mettre False en production)
DEBUG=False

# Domaines autorisés (séparés par une virgule)
ALLOWED_HOSTS=solidarite-comores.km,www.solidarite-comores.km,localhost,127.0.0.1

# Base de données (par défaut SQLite local, ou PostgreSQL en production)
# DATABASE_URL=postgres://user:password@localhost:5432/benevolat_db

# Fuseau horaire
TIME_ZONE=Indian/Comoro
